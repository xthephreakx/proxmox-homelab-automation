# Beszel monitoring stack
# Kopieer dit bestand naar .env en vul de waarden in.
# Voer beszel-setup.sh uit voor begeleide installatie.

# Jouw Traefik domein (zelfde als homelab en arrstack .env)
BASE_DOMAIN=local.yourdomain.com

# Publieke sleutel van de Beszel hub — ZELFDE voor alle agents.
# Klik "Add System" in de hub UI → kopieer de KEY waarde (ssh-ed25519 AAAA...)
BESZEL_KEY=

# Unieke token per Docker-VM systeem — gegenereerd bij "Add System" in de hub.
# (Elke agent / elk systeem krijgt zijn eigen TOKEN)
BESZEL_TOKEN=
