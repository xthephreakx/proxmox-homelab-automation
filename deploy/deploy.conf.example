# ==============================
# deploy-stack.sh configuratie
# ==============================
# Kopieer dit bestand naar deploy.conf en vul je eigen waarden in.
# deploy.conf staat in .gitignore en wordt nooit gecommit.

# Docker VM
VM_HOST=192.168.1.100
VM_USER=your-vm-user
SSH_KEY=~/.ssh/your_ssh_key

# Traefik domein (basis domein voor alle services)
BASE_DOMAIN=local.yourdomain.com

# Pad op de VM waar compose stacks leven
COMPOSE_BASE_PATH=/mnt/docker-data/compose
